{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".opencode/QUICKSTART.md"
  ],
  "shell": "pwsh",
  "skills": {
    "paths": [
      ".opencode/skills"
    ]
  },
  "mcp": {
    "docs-langchain": {
      "type": "remote",
      "url": "https://docs.langchain.com/mcp",
      "enabled": true
    },
    "reference-langchain": {
      "type": "remote",
      "url": "https://reference.langchain.com/mcp",
      "enabled": true
    }
  },
  "watcher": {
    "ignore": [
      ".design_docs/.obsidian/**",
      ".design_docs/assistent/graphify-out/**",
      ".venv/**"
    ]
  }
}
